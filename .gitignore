# ============================================
# Git Ignore for IntelliJ IDEA Java Projects
# ============================================

# Compiled class files
*.class
*.log
*.ctxt

# Output & Build directories
out/
**/out/
bin/
**/bin/
target/
**/target/
build/
**/build/

# IntelliJ IDEA IDE configuration files
.idea/
**/.idea/
*.iml
**/*.iml
*.iws
*.ipr
out/

# Eclipse IDE
.apt_generated
.classpath
.factorypath
.project
.settings/
**/.settings/
.springBeans
.sts4-cache

# NetBeans IDE
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.built-jar-path
/.nb-gradle/

# Visual Studio Code
.vscode/
**/.vscode/

# Operating System Files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Archives and Packages (optional cache)
*.nar
*.war
*.ear
*.rar

# Virtual Machine crash logs
hs_err_pid*
replay_pid*
